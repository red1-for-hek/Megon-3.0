# Airlock configuration — copy to .env and fill in.
# .env is git-ignored; .env.example is the committed template.

# --- Daytona (required: the disposable sandbox where we detonate — RUN it) ---
DAYTONA_API_KEY=
# Optional; leave blank for the default Daytona API endpoint.
DAYTONA_API_URL=

# --- ai& (the judge — JUDGE it; also the static-read fallback) ---
# OpenAI-compatible. Get a key at https://console.aiand.com and list the models you can
# call with `client.models.list()` (base_url below). deepseek-v4-flash is cheap/fast with
# a 1M context; deepseek-v4-pro is stronger; qwen3.6-27b is free (good for eval runs).
AIAND_API_KEY=
AIAND_BASE_URL=https://api.aiand.com/v1
AIAND_MODEL=deepseek-v4-flash

# --- Nosana (the static reader — READ it) ---
# The deployed code-model endpoint. Assumed OpenAI-compatible (e.g. Ollama's /v1, vLLM).
# Leave NOSANA_ENDPOINT blank and ai& does the static read instead (fallback). Set the
# endpoint to use real Nosana.
NOSANA_ENDPOINT=
NOSANA_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# --- Oxylabs (reputation / web intel — the 'senses') ---
# Web Scraper API basic-auth credentials. Optional: if unset, reputation runs on the free
# PyPI/OSV APIs alone. Sign up at https://oxylabs.io (Web Scraper API).
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# --- Doubleword (known-malware similarity match — MATCH it) ---
# OpenAI-compatible embeddings API. Redeem your hackathon credit at doubleword.ai/hacksprintsg
# for an sk-... key. Optional: if unset, the gate runs on the other legs. Confirm the exact
# embedding model your key can call with `client.models.list()`.
DOUBLEWORD_API_KEY=
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
DOUBLEWORD_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
