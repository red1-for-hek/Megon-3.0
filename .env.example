# ============================================================
# Megon 3.0 Environment Configuration
# Copy to .env and fill in values before running.
# ============================================================

# --- LLM Inference (REQUIRED) ---
# Use any OpenAI-compatible provider. Free options:
#   OpenRouter: https://openrouter.ai/ (free models available)
#   Ollama:     http://localhost:11434/v1 (local, free)
MODEL=openrouter/auto
BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# --- Nosana Decentralized Compute (OPTIONAL - only for GPU deployment) ---
NOSANA_API_KEY=
NOSANA_ENV=testnet

# --- GitHub (OPTIONAL - only if creating PRs) ---
GITHUB_TOKEN=

# --- Airlock Security (OPTIONAL - degrades gracefully) ---
DAYTONA_API_KEY=
AIAND_API_KEY=

# --- Service Ports ---
FORGE_PORT=5000
AIRLOCK_PORT=5001
ORCHESTRATOR_PORT=3000
